ath":158,"stem":159},"兔","/exotic-pet/rabbit","4.exotic-pet/2.rabbit",{"title":161,"icon":6,"path":162,"stem":163,"children":164,"page":6},"工具","/tools","5.tools",[165,169,178,182],{"title":166,"path":167,"stem":168,"description":70},"术语","/tools/terminology","5.tools/1.terminology",{"title":170,"path":171,"stem":172,"children":173,"page":6},"影像标记","/tools/label","5.tools/2.label",[174],{"title":175,"path":176,"stem":177},"分割工具比较","/tools/label/itk-snap_3d-slicer","5.tools/2.label/1.ITK-SNAP_3D-slicer",{"title":179,"path":180,"stem":181,"icon":48},"Websites","/tools/websites","5.tools/3.websites",{"title":183,"path":184,"stem":185,"children":186,"page":6},"编写笔记","/tools/notes","5.tools/4.notes",[187,191],{"title":188,"path":189,"stem":190,"icon":70},"Markdown CheatSheet","/tools/notes/markdown","5.tools/4.notes/1.markdown",{"title":192,"path":193,"stem":194,"icon":70},"Nuxt/Vue CheatSheet","/tools/notes/nuxt","5.tools/4.notes/2.nuxt",{"id":196,"title":144,"body":197,"description":271,"extension":272,"links":48,"meta":273,"navigation":274,"path":145,"seo":275,"stem":146,"__hash__":276},"docs/3.cardiology/5.TEE.md",{"type":198,"value":199,"toc":264},"minimark",[200,204,208,211,215],[201,202,203],"h2",{"id":203},"犬心三维模型",[205,206,207],"p",{},"下面的模型用于观察犬心外形及主要心腔、瓣膜和大血管的空间关系。页面会自动加载压缩后的三维模型。当前加入了示意食道路径、可移动的 TEE 探头和半透明超声切面；这些位置用于早期空间演示，并非标准解剖测量结果。",[209,210],"dog-heart-viewer",{},[212,213,214],"h3",{"id":214},"操作方式",[216,217,218,222,225,228,231,234,237,240,243,246,249,252,255,258,261],"ul",{},[219,220,221],"li",{},"鼠标拖动或单指拖动：旋转模型",[219,223,224],{},"鼠标滚轮或双指捏合：缩放模型",[219,226,227],{},"“全屏显示”：展开整个 TEE 模拟区域，按 Esc 或“退出全屏”恢复",[219,229,230],{},"“探头深度”：让探头沿食道曲线移动",[219,232,233],{},"也可以直接在三维模型中上下拖动 TEE 探头调整深度",[219,235,236],{},"“上下弯曲”：让探头末端柔性段向背侧、腹侧连续弯曲，探头面和切面起点会随之移动",[219,238,239],{},"“左右弯曲”：让探头末端柔性段向左右连续弯曲，探头面和切面起点会随之移动",[219,241,242],{},"“探头长轴旋转”：让整个探头绕自身长轴在 -180° 至 180° 范围内连续旋转；原先 36° 的姿态重新定义为当前 0°",[219,244,245],{},"“晶体顺时针旋转”：在 0–180° 范围内连续旋转扫查平面；当前 marker 朝向左侧的位置定义为 0°",[219,247,248],{},"右侧切面右上角的竖向“深度”滑杆：连续调整扇形扫查半径",[219,250,251],{},"在三维画布中拖动食道线条：移动整条食道及探头路径",[219,253,254],{},"拖动食道线条上的圆点：局部改变食道弯曲形状，探头和切面会同步跟随",[219,256,257],{},"三维视图右上角显示立体方向立方体（默认正面 L；H/T/A/P/R），随旋转同步；点击某一面可转到对应视角",[219,259,260],{},"右侧“对应切面”：以扇形显示当前扫查平面附近的二维薄层投影，右上方圆点表示当前晶体 marker 方向",[219,262,263],{},"当前二维图来自表面模型的薄层投影，并非真实超声灰阶图像；后续可继续增加结构标注和切面优化",{"title":70,"searchDepth":265,"depth":265,"links":266},2,[267],{"id":203,"depth":265,"text":203,"children":268},[269],{"id":214,"depth":270,"text":214},3,"使用 TresJS 交互查看犬心三维模型。","md",{},true,{"title":144,"description":271},"-5OuO-tPN6Bk5vxXeT3_RQgUrmyMY6cEDaX8JJ1blf0",[278,279],{"title":140,"path":141,"stem":142,"description":70,"icon":48,"children":-1},{"title":153,"path":154,"stem":155,"description":48,"icon":70,"children":-1},1794491726450]