"title":157,"path":158,"stem":159},"兔","/exotic-pet/rabbit","4.exotic-pet/2.rabbit",{"title":161,"icon":6,"path":162,"stem":163,"children":164,"page":6},"工具","/tools","5.tools",[165,169,178,182],{"title":166,"path":167,"stem":168,"description":70},"术语","/tools/terminology","5.tools/1.terminology",{"title":170,"path":171,"stem":172,"children":173,"page":6},"影像标记","/tools/label","5.tools/2.label",[174],{"title":175,"path":176,"stem":177},"分割工具比较","/tools/label/itk-snap_3d-slicer","5.tools/2.label/1.ITK-SNAP_3D-slicer",{"title":179,"path":180,"stem":181,"icon":48},"Websites","/tools/websites","5.tools/3.websites",{"title":183,"path":184,"stem":185,"children":186,"page":6},"编写笔记","/tools/notes","5.tools/4.notes",[187,191],{"title":188,"path":189,"stem":190,"icon":70},"Markdown CheatSheet","/tools/notes/markdown","5.tools/4.notes/1.markdown",{"title":192,"path":193,"stem":194,"icon":70},"Nuxt/Vue CheatSheet","/tools/notes/nuxt","5.tools/4.notes/2.nuxt",{"id":196,"title":98,"body":197,"description":304,"extension":305,"links":48,"meta":306,"navigation":307,"path":99,"seo":308,"stem":100,"__hash__":309},"docs/3.cardiology/1.physiology.md",{"type":198,"value":199,"toc":290},"minimark",[200,205,209,212,215,218,221,224,227,231,241,244,252,255,266,269,272,275,279,282,288],[201,202,204],"h2",{"id":203},"frank-starling定律","Frank-Starling定律",[206,207,208],"p",{},"Frank-Starling定律描述了心肌收缩力与心室充盈量之间的关系，即在一定范围内，心室舒张末期容积（前负荷）增加会导致心脏输出量增加。这一机制是心脏自身调节的基础，使心脏能够根据静脉回流的变化自动调整泵血功能。",[201,210,211],{"id":211},"心室重塑",[206,213,214],{},"鉴别诊断",[206,216,217],{},"后负荷增加，向心性肥厚（室壁增厚）：高血压",[206,219,220],{},"高血压、脱水、",[206,222,223],{},"后负荷减少：脱水/低血容量",[206,225,226],{},"前负荷减少：",[228,229,230],"h3",{"id":230},"向心性肥厚",[232,233,234,238],"ol",{},[235,236,237],"li",{},"心肌细胞增生",[235,239,240],{},"肌节增生伴心肌细胞肥大",[228,242,243],{"id":243},"离心性肥大",[232,245,246,249],{},[235,247,248],{},"肌节数量增加",[235,250,251],{},"肌节串联",[201,253,254],{"id":254},"神经体液激活",[232,256,257,260,263],{},[235,258,259],{},"交感神经",[235,261,262],{},"RAAS",[235,264,265],{},"利钠肽系统",[228,267,268],{"id":268},"交感神经系统激活",[206,270,271],{},"血压下降→化学感受器激活→大脑→交感神经激活→儿茶酚胺类激素释放（去甲肾上腺素、肾上腺素）→心脏肾上腺素能受体（β1受体）→提高心率、提高心肌收缩力",[206,273,274],{},"外周平滑肌→a1受体",[228,276,278],{"id":277},"raas激活","RAAS激活",[206,280,281],{},"肾素-血管紧张素-醛固酮系统是机体重要的体液调节机制，通过多个环节的级联反应来维持血压稳定和液体平衡。",[206,283,284],{},[285,286],"img",{"alt":70,"src":287},"/4/3.png",[228,289,265],{"id":265},{"title":70,"searchDepth":291,"depth":291,"links":292},2,[293,294,299],{"id":203,"depth":291,"text":204},{"id":211,"depth":291,"text":211,"children":295},[296,298],{"id":230,"depth":297,"text":230},3,{"id":243,"depth":297,"text":243},{"id":254,"depth":291,"text":254,"children":300},[301,302,303],{"id":268,"depth":297,"text":268},{"id":277,"depth":297,"text":278},{"id":265,"depth":297,"text":265},"心输出量","md",{},true,{"title":98,"description":304},"R2G2Dk-RC9grElEh_U0zOdLv2vPuJLoSeW8jadIMUsA",[311,312],{"title":89,"path":90,"stem":91,"description":70,"icon":48,"children":-1},{"title":102,"path":103,"stem":104,"description":313,"children":-1},"收藏夹",1794491726450]