ildren":83,"page":6},"X线","/imaging/xray","2.imaging/4.xray",[84,88],{"title":85,"path":86,"stem":87},"腹部X线","/imaging/xray/abdomen","2.imaging/4.xray/1.abdomen",{"title":89,"path":90,"stem":91,"icon":48},"放射术语","/imaging/xray/terms","2.imaging/4.xray/2.terms",{"title":93,"path":94,"stem":95,"children":96,"page":6},"心脏病","/cardiology","3.cardiology",[97,101,105,122,139,143],{"title":98,"path":99,"stem":100},"心脏生理","/cardiology/physiology","3.cardiology/1.physiology",{"title":102,"path":103,"stem":104},"心脏相关链接","/cardiology/2","3.cardiology/2",{"title":106,"path":107,"stem":108,"children":109,"page":6},"获得性心脏病","/cardiology/acquired","3.cardiology/2.acquired",[110,114,118],{"title":111,"path":112,"stem":113,"icon":48},"DCM","/cardiology/acquired/dcm","3.cardiology/2.acquired/1.DCM",{"title":115,"path":116,"stem":117,"icon":48},"LVOTO","/cardiology/acquired/lvoto","3.cardiology/2.acquired/2.lvoto",{"title":119,"path":120,"stem":121,"icon":48},"Mavacamten","/cardiology/acquired/mavacamten","3.cardiology/2.acquired/3.Mavacamten",{"title":123,"path":124,"stem":125,"children":126,"page":6},"先天性心脏病","/cardiology/congenital","3.cardiology/3.congenital",[127,131,135],{"title":128,"path":129,"stem":130},"总览","/cardiology/congenital/congenital_heart_disease","3.cardiology/3.congenital/1.congenital_heart_disease",{"title":132,"path":133,"stem":134},"大动脉转位","/cardiology/congenital/transposition-of-the-great-arteries","3.cardiology/3.congenital/2.transposition-of-the-great-arteries",{"title":136,"path":137,"stem":138,"icon":48},"MAPCAS","/cardiology/congenital/mapcas","3.cardiology/3.congenital/3.MAPCAS",{"title":140,"path":141,"stem":142,"icon":48},"TEER","/cardiology/teer","3.cardiology/4.TEER",{"title":144,"path":145,"stem":146},"经食道超声三维解剖","/cardiology/tee","3.cardiology/5.TEE",{"title":148,"path":149,"stem":150,"children":151,"page":6},"异宠","/exotic-pet","4.exotic-pet",[152,156],{"title":153,"path":154,"stem":155,"icon":70},"松鼠","/exotic-pet/squirrel","4.exotic-pet/1.squirrel",{"title":157,"path":158,"stem":159},"兔","/exotic-pet/rabbit","4.exotic-pet/2.rabbit",{"title":161,"icon":6,"path":162,"stem":163,"children":164,"page":6},"工具","/tools","5.tools",[165,169,178,182],{"title":166,"path":167,"stem":168,"description":70},"术语","/tools/terminology","5.tools/1.terminology",{"title":170,"path":171,"stem":172,"children":173,"page":6},"影像标记","/tools/label","5.tools/2.label",[174],{"title":175,"path":176,"stem":177},"分割工具比较","/tools/label/itk-snap_3d-slicer","5.tools/2.label/1.ITK-SNAP_3D-slicer",{"title":179,"path":180,"stem":181,"icon":48},"Websites","/tools/websites","5.tools/3.websites",{"title":183,"path":184,"stem":185,"children":186,"page":6},"编写笔记","/tools/notes","5.tools/4.notes",[187,191],{"title":188,"path":189,"stem":190,"icon":70},"Markdown CheatSheet","/tools/notes/markdown","5.tools/4.notes/1.markdown",{"title":192,"path":193,"stem":194,"icon":70},"Nuxt/Vue CheatSheet","/tools/notes/nuxt","5.tools/4.notes/2.nuxt",{"id":196,"title":197,"body":198,"description":70,"extension":861,"links":48,"meta":862,"navigation":863,"path":112,"seo":864,"stem":113,"__hash__":865},"docs/3.cardiology/2.acquired/1.DCM.md","DCM 扩张型心肌病",{"type":199,"value":200,"toc":832},"minimark",[201,204,207,210,213,217,221,225,228,238,241,244,258,273,276,279,284,299,303,343,346,349,363,366,369,395,398,412,415,450,456,459,462,504,507,513,536,550,554,577,581,601,605,628,631,666,669,673,693,697,700,741,744,763,766,780,783,791,794],[202,203,106],"badge",{},[202,205,206],{},"扩张型心肌病",[202,208,209],{},"ACD",[202,211,212],{},"Dilated Cardiomyopathy(DCM)",[214,215,216],"h2",{"id":216},"定义",[218,219,220],"p",{},"扩张型心肌病（Dilated Cardiomyopathy，DCM）是一种以单侧或双侧心室扩张为特征的心肌疾病，同时伴有收缩功能障碍。在人医中，诊断标准为左心室射血分数（LVEF）＜40%。\n患者可能出现心力衰竭。该病可分类为原发性DCM和继发性DCM。",[222,223,224],"h3",{"id":224},"兽医",[218,226,227],{},"DCM是犬类常见的获得性心脏病之一，其特征为心肌收缩力减弱，导致心室收缩功能下降，主要累及左心系统，尤其是左心室。左心室收缩功能下降时，心室射血能力降低，有效心输出量减少。\nDCM可累及单侧或双侧心室，但以左心室受累最为常见。\n当左心室收缩功能下降时，有效心输出量减少，部分回流入心室的血液无法充分排出，导致心室代偿性扩张和容量过载。\n主要病理生理改变包括：",[229,230,231,235],"ol",{},[232,233,234],"li",{},"左心室容量过载，可继发二尖瓣/三尖瓣关闭不全，导致二尖瓣、三尖瓣反流，听诊可闻及心杂音。",[232,236,237],{},"心脏节律异常，体循环灌注量下降，可导致虚弱、晕厥甚至猝死。",[218,239,240],{},"DCM约占犬所有心脏病的10%，多见于大型犬，在小型犬和猫中相对罕见。\n随年龄增长，DCM的患病风险增加；\u003C4岁患DCM的动物罕见。",[222,242,243],{"id":243},"危险因素",[229,245,246,249,252,255],{},[232,247,248],{},"犬（较猫更常见）",[232,250,251],{},"中老年（＞4岁）",[232,253,254],{},"大型犬（体重＞13.6kg）",[232,256,257],{},"高风险品种：",[259,260,261,264,267,270],"ul",{},[232,262,263],{},"杜宾犬",[232,265,266],{},"可卡犬",[232,268,269],{},"拳师犬",[232,271,272],{},"大丹犬",[214,274,275],{"id":275},"病因",[222,277,224],{"id":278},"兽医-1",[280,281,283],"h4",{"id":282},"原发性dcm","原发性DCM",[259,285,286,293],{},[232,287,288,292],{},[289,290,291],"strong",{},"家族遗传性","：杜宾犬、拳师犬、雪纳瑞等品种已被证实存在遗传易感性。人医中，DCM与Desmin（细胞骨架蛋白）、Lamin A/C（核膜蛋白）或Myosin（收缩蛋白）等基因突变有关。",[232,294,295,298],{},[289,296,297],{},"特发性","：若未发现明确的遗传联系，通常归类为特发性DCM。",[280,300,302],{"id":301},"继发性dcm","继发性DCM",[259,304,305,319,325,331,337],{},[232,306,307,310,311],{},[289,308,309],{},"牛磺酸缺乏","（罕见）：牛磺酸是一种氨基酸，对心肌细胞的发育和功能至关重要。\n",[259,312,313,316],{},[232,314,315],{},"饮食中牛磺酸缺乏（长期单一饮食、自制猫粮/狗粮）",[232,317,318],{},"机体牛磺酸吸收异常，如金毛寻回犬、可卡犬",[232,320,321,324],{},[289,322,323],{},"左旋肉碱缺乏","：左旋肉碱是一种氨基酸，对心肌细胞能量代谢和正常收缩功能至关重要。某些犬类（尤其是部分牛头梗和可卡犬）若缺乏左旋肉碱，可能导致DCM的发生。然而，在大多数患有DCM的犬类中，左旋肉碱缺乏的具体作用尚不明确。",[232,326,327,330],{},[289,328,329],{},"无谷物饮食（grain-free diet）","：2018年提出，无谷物饮食可能导致一些非易感品种发生DCM。无谷物饮食指不摄入所有谷物（如小麦、大米、燕麦、玉米、大麦等）及以谷物为基础的产品（如面包、面食、谷物食品），包括无麸质的谷物制品，转而侧重于摄入完整的天然食物，如蔬果、坚果、种子、肉类、鱼类、蛋类和乳制品，有时可少量摄入藜麦等\"伪谷物\"。",[232,332,333,336],{},[289,334,335],{},"毒物","：罕见，如蒽环类药物（多柔比星）",[232,338,339,342],{},[289,340,341],{},"感染","：罕见，如细小病毒",[222,344,345],{"id":345},"人医",[280,347,283],{"id":348},"原发性dcm-1",[259,350,351,354,359],{},[232,352,353],{},"主要为特发性，即找不到明确的病因。",[232,355,356,358],{},[289,357,291],{},"：DCM与Desmin（细胞骨架蛋白）、Lamin A/C（核膜蛋白）或Myosin（收缩蛋白）等基因突变有关。",[232,360,361,298],{},[289,362,297],{},[280,364,302],{"id":365},"继发性dcm-1",[218,367,368],{},"继发性病因包括：",[259,370,371,374,377,380,383,386,389,392],{},[232,372,373],{},"感染性心肌炎（如病毒性心肌炎、美洲锥虫病、莱姆病）",[232,375,376],{},"缺血性心肌病",[232,378,379],{},"高血压性心肌病",[232,381,382],{},"药物诱发（如蒽环类药物）",[232,384,385],{},"酗酒",[232,387,388],{},"人类免疫缺陷病毒（HIV）感染",[232,390,391],{},"围产期心肌病",[232,393,394],{},"浸润性疾病",[280,396,397],{"id":397},"其他",[259,399,400,406],{},[232,401,402,405],{},[289,403,404],{},"性别","：男性发病率高于女性（M>F）",[232,407,408,411],{},[289,409,410],{},"应激性心肌病","：又称心碎综合征或Takotsubo心肌病，是一种相对少见但报道日益增多的病因。通常被归类为独立于原发性DCM的疾病。其特征是左心室（LV）心尖短暂性球形扩张，通常发生在严重的心理或生理应激之后，被认为是由强烈的儿茶酚胺激增引起的。",[214,413,414],{"id":414},"临床表现",[259,416,417,420,423,426,429,432,435,438,441,444,447],{},[232,418,419],{},"呼吸急促，静息或睡眠时呼吸频率＞30-35次/分",[232,421,422],{},"呼吸费力",[232,424,425],{},"咳嗽、干呕",[232,427,428],{},"虚弱",[232,430,431],{},"活动量下降",[232,433,434],{},"晕厥或晕倒",[232,436,437],{},"体重、食欲下降",[232,439,440],{},"体重减轻",[232,442,443],{},"腹围增大（腹水）",[232,445,446],{},"互动减少",[232,448,449],{},"猝死",[218,451,452,455],{},[289,453,454],{},"注意","：易患品种（如杜宾犬、拳师犬等）建议每年进行心脏筛查。",[214,457,458],{"id":458},"诊断",[222,460,224],{"id":461},"兽医-2",[259,463,464,470,476,481,486,492,498],{},[232,465,466,469],{},[289,467,468],{},"X线检查","：可见重力侧肺部渗出、肺水肿",[232,471,472,475],{},[289,473,474],{},"超声心动图","：易患品种建议每年监测",[232,477,478],{},[289,479,480],{},"24小时动态心电图（Holter监测）",[232,482,483],{},[289,484,485],{},"心电图（ECG）",[232,487,488,491],{},[289,489,490],{},"NT-proBNP","：心脏生物标志物检测",[232,493,494,497],{},[289,495,496],{},"基因检测","：适用于易感品种",[232,499,500,503],{},[289,501,502],{},"排除其他疾病","：排查对DCM的不利因素，如高血压、肾病等",[222,505,506],{"id":506},"超声心动图检查",[218,508,509,512],{},[289,510,511],{},"关键指标","：左心室容量过载、左心室收缩功能障碍",[259,514,515,518,521,524,527,530,533],{},[232,516,517],{},"EDV↑（舒张末期容积增加）",[232,519,520],{},"ESV↑（收缩末期容积增加）",[232,522,523],{},"LVIDd↑（左心室舒张末期内径增加）",[232,525,526],{},"LVIDs↑（左心室收缩末期内径增加）",[232,528,529],{},"LVEF↓（左心室射血分数降低）",[232,531,532],{},"LV FAC↓（左心室面积缩短分数降低）",[232,534,535],{},"LVFS↓（左心室短轴缩短率降低）",[218,537,538,543],{},[539,540],"img",{"alt":541,"src":542},"alt text","1.ACD/2025-12-31_DCM.png",[544,545,549],"a",{"href":546,"rel":547},"https://app.paperpile.com/view/?id=f6fdca0e-aa57-4d05-ab19-63ad61d4e3e0",[548],"nofollow","参考文献paperpile链接",[222,551,553],{"id":552},"轻度dcm","轻度DCM",[259,555,556,559,562,565,568,571,574],{},[232,557,558],{},"左心室容量过载",[232,560,561],{},"左心室收缩功能障碍",[232,563,564],{},"纵向应变↓，横向、轴向应变↓",[232,566,567],{},"心室内传导障碍导致的心室不同步",[232,569,570],{},"已知的基因突变",[232,572,573],{},"高风险犬种",[232,575,576],{},"近亲家族史",[222,578,580],{"id":579},"中度dcm","中度DCM",[259,582,583,586,589,592,595,598],{},[232,584,585],{},"可重复的左心室收缩功能障碍，不伴随左心室扩张",[232,587,588],{},"明确的左心室收缩功能障碍，不伴随左心室扩张",[232,590,591],{},"进行性左心室扩张，伴不明原因的左心室收缩功能障碍",[232,593,594],{},"心房/心室异位搏动，或心动过速，传导异常",[232,596,597],{},"心脏生物标志物升高：cTnI（心肌肌钙蛋白I）、NT-proBNP等",[232,599,600],{},"听诊异常：节律异常、二尖瓣反流、奔马律",[222,602,604],{"id":603},"重度dcm","重度DCM",[259,606,607,610,613,616,619,622,625],{},[232,608,609],{},"明确的左心室扩张合并左心室收缩功能障碍",[232,611,612],{},"左心房扩张",[232,614,615],{},"左心室舒张功能障碍：2-4级",[232,617,618],{},"功能性二尖瓣反流/三尖瓣反流",[232,620,621],{},"右心室扩张±右心室收缩功能障碍±右心房扩张（伴随左心室扩张、左心室收缩功能障碍）",[232,623,624],{},"心力衰竭的临床表现/充血性心力衰竭（CHF）",[232,626,627],{},"晕厥、猝死",[222,629,345],{"id":630},"人医-1",[259,632,633,639,644,649,654,660],{},[232,634,635,638],{},[289,636,637],{},"实验室检查","：甲状腺功能检查（排除甲状腺功能减退）、血常规（排除贫血）",[232,640,641,643],{},[289,642,468],{},"：心影增大，肺水肿、肺部渗出、肺静脉增粗",[232,645,646,648],{},[289,647,485],{},"：非特异性ST段和T波异常，可能伴房颤（AF）",[232,650,651,653],{},[289,652,474],{},"：排查心室内血栓或附壁血栓，鉴别限制性心肌病（RCM）、肥厚性心肌病（HCM）",[232,655,656,659],{},[289,657,658],{},"冠脉造影","：明确冠状动脉解剖结构，排除隐匿性缺血性疾病",[232,661,662,665],{},[289,663,664],{},"心肌活检","：极少数情况下，当怀疑存在贮积性疾病或浸润性病变时进行",[214,667,668],{"id":668},"治疗方案",[222,670,672],{"id":671},"无症状型dcm","无症状型DCM",[259,674,675,681,687],{},[232,676,677,680],{},[289,678,679],{},"匹莫苯丹","（Pimobendan）：正性肌力药物",[232,682,683,686],{},[289,684,685],{},"ACEI","（血管紧张素转换酶抑制剂）：如依那普利、贝那普利",[232,688,689,692],{},[289,690,691],{},"抗心律失常药","：如索他洛尔",[222,694,696],{"id":695},"有症状型dcm","有症状型DCM",[280,698,699],{"id":699},"心力衰竭治疗",[259,701,702,708,712,717,723,729,735],{},[232,703,704,707],{},[289,705,706],{},"呋塞米","（Furosemide）：利尿剂",[232,709,710,680],{},[289,711,679],{},[232,713,714,716],{},[289,715,685],{},"：如依那普利、贝那普利",[232,718,719,722],{},[289,720,721],{},"螺内酯","（Spironolactone）：醛固酮受体拮抗剂",[232,724,725,728],{},[289,726,727],{},"索他洛尔","（Sotalol）：抗心律失常药",[232,730,731,734],{},[289,732,733],{},"美西律","（Mexiletine）：抗心律失常药，主要用于治疗室性心律失常，特别适用于某些犬类患者",[232,736,737,740],{},[289,738,739],{},"地尔硫卓","（Diltiazem）：钙通道阻滞剂，可减缓心脏电信号传导，帮助控制心率",[214,742,743],{"id":743},"并发症",[259,745,746,749,752,755,758,760],{},[232,747,748],{},"充血性心力衰竭",[232,750,751],{},"脑卒中/脑梗死",[232,753,754],{},"瓣膜性心脏病",[232,756,757],{},"心律失常",[232,759,449],{},[232,761,762],{},"血栓栓塞",[214,764,765],{"id":765},"术后及康复护理",[259,767,768,774],{},[232,769,770,773],{},[289,771,772],{},"饮食管理","：限制钠盐和水的摄入",[232,775,776,779],{},[289,777,778],{},"适度运动","：保持适度的运动量，避免过度劳累",[214,781,782],{"id":782},"预后",[259,784,785,788],{},[232,786,787],{},"DCM是一种进行性心脏病，目前尚无治愈方法。大多数患者最终会发展为心力衰竭。人医中，近50%的患者会在5年内死亡。",[232,789,790],{},"决定预后的最重要因素包括：1）饮食管理；2）药物依从性；3）运动计划。",[214,792,793],{"id":793},"延伸阅读",[229,795,796,803,810],{},[232,797,798],{},[544,799,802],{"href":800,"rel":801},"https://www.ncbi.nlm.nih.gov/books/NBK441911/",[548],"Mahmaljy, H., Yelamanchili, V.S. and Singhal, M. (2025) ‘Dilated Cardiomyopathy’, in StatPearls. Treasure Island (FL): StatPearls Publishing.",[232,804,805],{},[544,806,809],{"href":807,"rel":808},"https://onlinelibrary.wiley.com/doi/full/10.1111/jsap.13851",[548],"Lee, R.P. et al. (2025) ‘Radiographic features of cardiogenic pulmonary oedema in dogs with dilated cardiomyopathy’, The journal of small animal practice, 66(7), pp. 470–476.",[232,811,812,817,818,822,823,817,827,822],{},[544,813,816],{"href":814,"rel":815},"https://paperpile.com/shared/snLhEIOnARJmusTLkUjCU0w",[548],"DUKES-MCEWAN J, BORGARELLI M, TIDHOLM A, et al. Proposed guidelines for the diagnosis of canine idiopathic dilated cardiomyopathy","[",[544,819,821],{"href":814,"rel":820},[548],"J","]",