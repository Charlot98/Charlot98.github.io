,"children":83,"page":6},"X线","/imaging/xray","2.imaging/4.xray",[84,88],{"title":85,"path":86,"stem":87},"腹部X线","/imaging/xray/abdomen","2.imaging/4.xray/1.abdomen",{"title":89,"path":90,"stem":91,"icon":48},"放射术语","/imaging/xray/terms","2.imaging/4.xray/2.terms",{"title":93,"path":94,"stem":95,"children":96,"page":6},"心脏病","/cardiology","3.cardiology",[97,101,105,122,139,143],{"title":98,"path":99,"stem":100},"心脏生理","/cardiology/physiology","3.cardiology/1.physiology",{"title":102,"path":103,"stem":104},"心脏相关链接","/cardiology/2","3.cardiology/2",{"title":106,"path":107,"stem":108,"children":109,"page":6},"获得性心脏病","/cardiology/acquired","3.cardiology/2.acquired",[110,114,118],{"title":111,"path":112,"stem":113,"icon":48},"DCM","/cardiology/acquired/dcm","3.cardiology/2.acquired/1.DCM",{"title":115,"path":116,"stem":117,"icon":48},"LVOTO","/cardiology/acquired/lvoto","3.cardiology/2.acquired/2.lvoto",{"title":119,"path":120,"stem":121,"icon":48},"Mavacamten","/cardiology/acquired/mavacamten","3.cardiology/2.acquired/3.Mavacamten",{"title":123,"path":124,"stem":125,"children":126,"page":6},"先天性心脏病","/cardiology/congenital","3.cardiology/3.congenital",[127,131,135],{"title":128,"path":129,"stem":130},"总览","/cardiology/congenital/congenital_heart_disease","3.cardiology/3.congenital/1.congenital_heart_disease",{"title":132,"path":133,"stem":134},"大动脉转位","/cardiology/congenital/transposition-of-the-great-arteries","3.cardiology/3.congenital/2.transposition-of-the-great-arteries",{"title":136,"path":137,"stem":138,"icon":48},"MAPCAS","/cardiology/congenital/mapcas","3.cardiology/3.congenital/3.MAPCAS",{"title":140,"path":141,"stem":142,"icon":48},"TEER","/cardiology/teer","3.cardiology/4.TEER",{"title":144,"path":145,"stem":146},"经食道超声三维解剖","/cardiology/tee","3.cardiology/5.TEE",{"title":148,"path":149,"stem":150,"children":151,"page":6},"异宠","/exotic-pet","4.exotic-pet",[152,156],{"title":153,"path":154,"stem":155,"icon":70},"松鼠","/exotic-pet/squirrel","4.exotic-pet/1.squirrel",{"title":157,"path":158,"stem":159},"兔","/exotic-pet/rabbit","4.exotic-pet/2.rabbit",{"title":161,"icon":6,"path":162,"stem":163,"children":164,"page":6},"工具","/tools","5.tools",[165,169,178,182],{"title":166,"path":167,"stem":168,"description":70},"术语","/tools/terminology","5.tools/1.terminology",{"title":170,"path":171,"stem":172,"children":173,"page":6},"影像标记","/tools/label","5.tools/2.label",[174],{"title":175,"path":176,"stem":177},"分割工具比较","/tools/label/itk-snap_3d-slicer","5.tools/2.label/1.ITK-SNAP_3D-slicer",{"title":179,"path":180,"stem":181,"icon":48},"Websites","/tools/websites","5.tools/3.websites",{"title":183,"path":184,"stem":185,"children":186,"page":6},"编写笔记","/tools/notes","5.tools/4.notes",[187,191],{"title":188,"path":189,"stem":190,"icon":70},"Markdown CheatSheet","/tools/notes/markdown","5.tools/4.notes/1.markdown",{"title":192,"path":193,"stem":194,"icon":70},"Nuxt/Vue CheatSheet","/tools/notes/nuxt","5.tools/4.notes/2.nuxt",{"id":196,"title":115,"body":197,"description":492,"extension":493,"links":48,"meta":494,"navigation":495,"path":116,"seo":496,"stem":117,"__hash__":497},"docs/3.cardiology/2.acquired/2.lvoto.md",{"type":198,"value":199,"toc":475},"minimark",[200,211,215,225,228,231,283,286,290,310,313,324,328,363,366,369,407,410,418,421,424,466,470],[201,202,203,204],"p",{},"原文链接：",[205,206,210],"a",{"href":207,"rel":208},"https://litfl.com/left-ventricular-outflow-tract-obstruction-lvoto/",[209],"nofollow","life in the fastlane",[212,213,214],"h2",{"id":214},"关键点",[216,217,218,222],"ul",{},[219,220,221],"li",{},"左心室流出道梗阻（Left ventricular outflow tract obstruction,LVOTO）通常与二尖瓣收缩期前移（SAM）相关。",[219,223,224],{},"LVOTO和SAM可能导致低心输出量状态，如此时使用正性肌力药物，可能恶化病情。",[212,226,227],{"id":227},"病因",[201,229,230],{},"常见病因",[216,232,233,236,239,242,245,259,262,265,274,277,280],{},[219,234,235],{},"HCM",[219,237,238],{},"导致HCM的其它原因",[219,240,241],{},"二尖瓣修复术术后（二尖瓣退行性/黏液瘤样病变）\n罕见病因",[219,243,244],{},"主动脉瓣狭窄行主动脉瓣置换术（AVR）后",[219,246,247,248],{},"先天性心脏病\n",[216,249,250,253,256],{},[219,251,252],{},"主动脉瓣下狭窄",[219,254,255],{},"大动脉转位（transposition of the great arteries）",[219,257,258],{},"伴有房室间隔缺损的左心室流出道梗阻",[219,260,261],{},"心肌梗死后（由于低动力区和高动力区相互抵消而导致左心室几何结构改变）",[219,263,264],{},"心尖球形综合征Takotsubo cardiomyopathy （因为典型时左心室呈“球形膨胀、颈部狭窄”的章鱼壶样）",[219,266,267,268],{},"S形室间隔 Sigmoid septum （老年人因纤维化和肥厚引起的室间隔膨出）\n",[269,270,271],"blockquote",{},[201,272,273],{},"语常描述左心室基底段室间隔局限性肥厚、呈“S形”或“章鱼壶样”弯曲的解剖变异，多见于老年、高血压患者，有时也称为“基底室间隔突起”或“孤立性基底室间隔肥厚”",[219,275,276],{},"处于低血容量/血管扩张状态的危重患者（例如感染性休克）",[219,278,279],{},"肺源性心脏病 Cor pulmonale （右心室扩大，伴左心室缩小）",[219,281,282],{},"心脏移植排斥反应 Cardiac allograft rejection",[212,284,285],{"id":285},"病生理",[287,288,235],"h3",{"id":289},"hcm",[216,291,292,295,298,301,304,307],{},[219,293,294],{},"HCM 最常累及室间隔（约占 60%），这被称为不对称性室间隔肥厚。",[219,296,297],{},"HCM 比 HOCM 更合适，因为左心室流出道梗阻的存在情况会随负荷条件而动态变化。",[219,299,300],{},"在 HCM 患者中，舒张期二尖瓣可能看起来正常。",[219,302,303],{},"在肥厚型心肌病（HCM）中可见二尖瓣乳头肌前移，导致前叶腱索松弛，从而易发生收缩期前移（SAM）。",[219,305,306],{},"在收缩期，二尖瓣装置向前移动（收缩期前移），前叶瓣膜的凸起可能触及室间隔，导致左心室流出道梗阻（LVOTO）。",[219,308,309],{},"SAM 在收缩末期最为明显，因为此时左心室排空，心腔大小减小（因此 SAM 是一种动态梗阻，即在整个收缩期逐渐加重，这与主动脉瓣狭窄这种固定性梗阻不同）。",[287,311,312],{"id":312},"二尖瓣修复术",[216,314,315,318,321],{},[219,316,317],{},"除非接受手术，否则在黏液瘤性二尖瓣疾病中很少发生 SAM。",[219,319,320],{},"因此，二尖瓣修复术后的收缩期前移被认为是一种医源性疾病。",[219,322,323],{},"二尖瓣瓣叶、瓣环和瓣下结构（例如腱索、乳头肌）的缺陷都可能导致二尖瓣修复术后发生收缩期前移（SAM）。",[287,325,327],{"id":326},"sam-的加重因素包括","SAM 的加重因素包括：",[216,329,330,349],{},[219,331,332,333],{},"导致二尖瓣间距减小的因素\n",[216,334,335,346],{},[219,336,337,338],{},"左心室舒张末期容积减少\n",[216,339,340,343],{},[219,341,342],{},"左心室充盈不足/血容量不足",[219,344,345],{},"心动过速（舒张期充盈时间缩短）",[219,347,348],{},"肥大（腔体积减小）",[219,350,351,352],{},"增加左心室流出道（LVOT）血流速度的因素，会因文丘里效应（速度增加导致压力下降）和阻力而将二尖瓣瓣叶拉入 LVOT。\n",[216,353,354,357,360],{},[219,355,356],{},"心肌过度收缩（正性肌力药物）",[219,358,359],{},"后负荷降低",[219,361,362],{},"运动",[212,364,365],{"id":365},"评估",[287,367,368],{"id":368},"病史",[216,370,371,389,404],{},[219,372,373,374],{},"诱发因素，尤其是：\n",[216,375,376,378,386],{},[219,377,235],{},[219,379,380,381],{},"如果二尖瓣存在退行性疾病，前瓣和/或后瓣过度冗余，和/或瓣膜刚性环尺寸过小，则需进行二尖瓣修复。\n",[216,382,383],{},[219,384,385],{},"并非缺血性二尖瓣修复术（瓣叶粘连）或二尖瓣置换术（瓣叶切除）。",[219,387,388],{},"导致LVOTO/SAM的其它病因",[219,390,391,392],{},"加剧因素，例如：\n",[216,393,394,397,399,402],{},[219,395,396],{},"正性肌力药物",[219,398,342],{},[219,400,401],{},"心动过速",[219,403,359],{},[219,405,406],{},"与低输出状态或诱发因素相符的症状（例如晕厥、胸痛、呼吸困难、心悸）",[287,408,409],{"id":409},"体格检查",[216,411,412,415],{},[219,413,414],{},"收缩末期心杂音",[219,416,417],{},"低心输出量状态（无心包填塞）",[287,419,420],{"id":420},"心超",[201,422,423],{},"经胸超声心动图 (TTE) 可提供最佳的多普勒角度，用于评估左心室流出道 (LVOT) 压差。如果患者经胸超声图像显示不佳或怀疑存在瓣下膜，则可能需要进行经食道超声心动图 (TOE)。\n超声心动图检查结果可能包括：",[216,425,426,429,432,435,443,446,449,452,460,463],{},[219,427,428],{},"LVDd↓",[219,430,431],{},"基底部室间隔增厚",[219,433,434],{},"收缩功能正常，无局部室壁运动异常",[219,436,437,438],{},"左心室流出道流速偏高\n",[216,439,440],{},[219,441,442],{},"SAM的特征是“剑形多普勒血流曲线，加速后期出现”",[219,444,445],{},"二维视觉评估显示收缩期左心室流出道面积减小",[219,447,448],{},"乳头肌肥大并向前移位",[219,450,451],{},"二尖瓣瓣叶的收缩期前向运动（SAM），可伴或不伴室间隔‑前瓣叶接触。",[219,453,454,455],{},"CW测的左心室流出道（LVOT）峰值压差升高（>30 mmHg）。\n",[216,456,457],{},[219,458,459],{},"Generally >50 mmHg required for haemodynamic significance (Slama et al, 2016)\n通常需要 >50 mmHg 才具有血液动力学意义（Slama 等人，2016）",[219,461,462],{},"二尖瓣反流伴后向偏心射流，由瓣叶闭合畸形引起",[219,464,465],{},"肥厚型心肌病合左心室流出道梗阻",[287,467,469],{"id":468},"ecg","ECG",[216,471,472],{},[219,473,474],{},"高振幅、非特异性ST段和T波改变，刀尖样Q波",{"title":70,"searchDepth":476,"depth":476,"links":477},2,[478,479,480,486],{"id":214,"depth":476,"text":214},{"id":227,"depth":476,"text":227},{"id":285,"depth":476,"text":285,"children":481},[482,484,485],{"id":289,"depth":483,"text":235},3,{"id":312,"depth":483,"text":312},{"id":326,"depth":483,"text":327},{"id":365,"depth":476,"text":365,"children":487},[488,489,490,491],{"id":368,"depth":483,"text":368},{"id":409,"depth":483,"text":409},{"id":420,"depth":483,"text":420},{"id":468,"depth":483,"text":469},"左心室流出道梗阻","md",{},{"icon":48},{"title":115,"description":492},"9n-kp0Oe_APpn7XFyAj18qo9SH67v-tC09akz9VgrV4",[499,500],{"title":111,"path":112,"stem":113,"description":70,"icon":48,"children":-1},{"title":119,"path":120,"stem":121,"description":70,"icon":48,"children":-1},1794491726450]