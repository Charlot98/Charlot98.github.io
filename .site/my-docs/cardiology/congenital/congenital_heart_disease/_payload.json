瓣发育不良 tricuspid dysplasia (TD)",[208,242,243],{},"主动脉瓣狭窄 valvular aortic stenosis (VAS)",[208,245,246],{},"室间隔缺损 ventricular septal defect (VSD)",[201,248,249],{"id":249},"超声诊断标准",[251,252,253,265],"table",{},[254,255,256],"thead",{},[257,258,259,262],"tr",{},[260,261,123],"th",{},[260,263,264],{},"心超标准",[266,267,268,277,285,293,301,309,317,325,333,341,349,357,365],"tbody",{},[257,269,270,274],{},[271,272,273],"td",{},"冠状动脉异常，ACA",[271,275,276],{},"冠状动脉畸形，源自主动脉，沿右心室流出道瓣下区域延伸至肺动脉瓣下方；主肺动脉狭窄后扩张",[257,278,279,282],{},[271,280,281],{},"房间隔缺损，ASD",[271,283,284],{},"心室舒张期，血液通过心房隔缺损流动；缺损处压力梯度较低，分流的大小取决于缺损大小和舒张期每个心室对流入的阻力；采用微气泡对比技术确认分流的方向；特别注意避免因成像伪影（正常房间隔的某些部分变薄和尾腔静脉的静脉回流正常）而导致房间隔缺损的假阳性诊断。",[257,286,287,290],{},[271,288,289],{},"左侧三房心，Cor triatriatum sinister",[271,291,292],{},"左心房被分成两个腔室，由一层膜阻碍来自近端腔室的静脉回流，导致静脉淤血",[257,294,295,298],{},[271,296,297],{},"二尖瓣发育不良，MD",[271,299,300],{},"二尖瓣装置位置、形状、运动或附着异常；二尖瓣反流；左心房扩大；流入道梗阻以及伴有二尖瓣狭窄时高速反流束进入左心室",[257,302,303,306],{},[271,304,305],{},"动脉导管未闭，PDA",[271,307,308],{},"动脉导管显影；高速、持续的导管血流流向肺动脉瓣；左心室偏心性肥大；左心房、升主动脉和肺动脉扩张；微泡造影技术用于确认分流方向",[257,310,311,314],{},[271,312,313],{},"持久性左前腔静脉，PLCVC",[271,315,316],{},"房室沟附近冠状窦扩张",[257,318,319,322],{},[271,320,321],{},"肺动脉狭窄，PS",[271,323,324],{},"肺动脉瓣畸形；右心室流出道狭窄；右心室向心性肥厚；右心房不同程度扩张；主肺动脉狭窄后扩张；高速射流起自梗阻性开口远端；肺动脉瓣闭合不全。",[257,326,327,330],{},[271,328,329],{},"反向PDA，RPDA",[271,331,332],{},"动脉导管显像；右心室向心性肥大；主肺动脉扩张；肺动脉高压（三尖瓣或肺动脉瓣关闭不全射流检查）；微泡造影技术使右心、肺动脉和降主动脉显影（通过腹主动脉成像可获得最佳显像效果）",[257,334,335,338],{},[271,336,337],{},"主动脉瓣下狭窄，SAS",[271,339,340],{},"主动脉瓣下梗阻性病变（主动脉瓣下方的结节或纤维嵴）；左心室向心性肥厚；主动脉狭窄后扩张；高速射流起自梗阻性开口远端正；主动脉瓣或二尖瓣关闭不全。",[257,342,343,346],{},[271,344,345],{},"法洛四联，ToF",[271,347,348],{},"右心室流出道梗阻性病变；继发性右心室肥大；膜周型室间隔缺损；右位主动脉（右位主动脉）；微泡造影技术用于确认分流方向",[257,350,351,354],{},[271,352,353],{},"三尖瓣发育不良，TD",[271,355,356],{},"三尖瓣瓣叶位置、形状、运动或附着异常；三尖瓣反流；右心房扩大；流入道梗阻以及伴有三尖瓣狭窄时高速反流进入右心室",[257,358,359,362],{},[271,360,361],{},"主动脉瓣狭窄，AS",[271,363,364],{},"瓣膜阻塞性病变（瓣叶增厚或瓣环发育不良）；左心室向心性肥厚；主动脉狭窄后扩张；阻塞口远端出现高速射流；主动脉瓣或二尖瓣关闭不全",[257,366,367,370],{},[271,368,369],{},"室间隔缺损，VSD",[271,371,372],{},"心室收缩期血液经室间隔缺损流入心室；分流量的大小取决于缺损大小和心室间的收缩压梯度；左心房和左心室出现不同程度的扩大；采用微泡造影技术确认分流方向。",[201,374,375],{"id":375},"犬先天性心脏病患病率",[251,377,378,391],{},[254,379,380],{},[257,381,382,385,388],{},[260,383,384],{},"类型",[260,386,387],{},"数量",[260,389,390],{},"百分比",[266,392,393,404,415,426,437,448,459,470,481,492],{},[257,394,395,398,401],{},[271,396,397],{},"PDA",[271,399,400],{},"1207",[271,402,403],{},"25.7",[257,405,406,409,412],{},[271,407,408],{},"SAS",[271,410,411],{},"1102",[271,413,414],{},"23.5",[257,416,417,420,423],{},[271,418,419],{},"PS",[271,421,422],{},"1039",[271,424,425],{},"22.1",[257,427,428,431,434],{},[271,429,430],{},"VSD",[271,432,433],{},"413",[271,435,436],{},"8.8",[257,438,439,442,445],{},[271,440,441],{},"TVD",[271,443,444],{},"216",[271,446,447],{},"4.6",[257,449,450,453,456],{},[271,451,452],{},"其它缺陷",[271,454,455],{},"160",[271,457,458],{},"3.4",[257,460,461,464,467],{},[271,462,463],{},"PRAA或其它血管环异常",[271,465,466],{},"155",[271,468,469],{},"3.3",[257,471,472,475,478],{},[271,473,474],{},"ToF",[271,476,477],{},"110",[271,479,480],{},"2.3",[257,482,483,486,489],{},[271,484,485],{},"ASD",[271,487,488],{},"89",[271,490,491],{},"1.9",[257,493,494,497,500],{},[271,495,496],{},"总计",[271,498,499],{},"4694",[271,501,502],{},"100",[201,504,505],{"id":505},"猫先天性心脏病患病率",[251,507,508,518],{},[254,509,510],{},[257,511,512,514,516],{},[260,513,384],{},[260,515,387],{},[260,517,390],{},[266,519,520,530,540,550,561,572,583,593,603,614,625,635,646,657,665],{},[257,521,522,524,527],{},[271,523,430],{},[271,525,526],{},"80",[271,528,529],{},"18.4",[257,531,532,534,537],{},[271,533,397],{},[271,535,536],{},"49",[271,538,539],{},"11.3",[257,541,542,544,547],{},[271,543,441],{},[271,545,546],{},"47",[271,548,549],{},"10.8",[257,551,552,555,558],{},[271,553,554],{},"MVD",[271,556,557],{},"44",[271,559,560],{},"10.1",[257,562,563,566,569],{},[271,564,565],{},"AVSD",[271,567,568],{},"42",[271,570,571],{},"9.7",[257,573,574,577,5