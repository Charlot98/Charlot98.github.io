[{"data":1,"prerenderedAt":617},["ShallowReactive",2],{"navigation_docs":3,"docs:-imaging-thorax-tei":195,"docs:-imaging-thorax-tei-surround":614},[4,21,92,147,160],{"title":5,"icon":6,"path":7,"stem":8,"children":9,"page":6},"使用手册",false,"/getting-started","1.getting-started",[10,16],{"title":11,"path":12,"stem":13,"icon":14,"description":15},"文档框架","/getting-started/structure","1.getting-started/1.structure","i-mdi-file-tree-outline","显示文档框架及主要功能展示",{"title":17,"path":18,"stem":19,"icon":20},"编者指引","/getting-started/guideline","1.getting-started/2.guideline","i-tabler-arrow-guide-filled",{"title":22,"path":23,"stem":24,"children":25,"page":6},"影像诊断","/imaging","2.imaging",[26,39,57,79],{"title":27,"path":28,"stem":29,"children":30,"page":6},"头部","/imaging/head","2.imaging/1.head",[31,35],{"title":32,"path":33,"stem":34},"牙齿","/imaging/head/dental","2.imaging/1.head/1.dental",{"title":36,"path":37,"stem":38},"侧脑室","/imaging/head/brain","2.imaging/1.head/2.brain",{"title":40,"path":41,"stem":42,"children":43,"page":6},"胸部","/imaging/thorax","2.imaging/2.thorax",[44,49,53],{"title":45,"path":46,"stem":47,"icon":48},"心超基础","/imaging/thorax/echo_basic","2.imaging/2.thorax/1.echo_basic",null,{"title":50,"path":51,"stem":52,"icon":48},"超声进阶","/imaging/thorax/echo_advanced","2.imaging/2.thorax/2.echo_advanced",{"title":54,"path":55,"stem":56},"Tei指数","/imaging/thorax/tei","2.imaging/2.thorax/3.tei",{"title":58,"path":59,"stem":60,"children":61,"page":6},"腹部","/imaging/abdomen","2.imaging/3.abdomen",[62,66,71,75],{"title":63,"path":64,"stem":65},"肝脏","/imaging/abdomen/liver","2.imaging/3.abdomen/1.liver",{"title":67,"path":68,"stem":69,"icon":70},"先天性胆管板异常","/imaging/abdomen/gb","2.imaging/3.abdomen/2.gb","",{"title":72,"path":73,"stem":74,"icon":48},"腹部淋巴结","/imaging/abdomen/lymphnodes","2.imaging/3.abdomen/3.lymphnodes",{"title":76,"path":77,"stem":78},"胰腺炎","/imaging/abdomen/pancreatitis","2.imaging/3.abdomen/4.pancreatitis",{"title":80,"path":81,"stem":82,"children":83,"page":6},"X线","/imaging/xray","2.imaging/4.xray",[84,88],{"title":85,"path":86,"stem":87},"腹部X线","/imaging/xray/abdomen","2.imaging/4.xray/1.abdomen",{"title":89,"path":90,"stem":91,"icon":48},"放射术语","/imaging/xray/terms","2.imaging/4.xray/2.terms",{"title":93,"path":94,"stem":95,"children":96,"page":6},"心脏病","/cardiology","3.cardiology",[97,101,105,122,139,143],{"title":98,"path":99,"stem":100},"心脏生理","/cardiology/physiology","3.cardiology/1.physiology",{"title":102,"path":103,"stem":104},"心脏相关链接","/cardiology/2","3.cardiology/2",{"title":106,"path":107,"stem":108,"children":109,"page":6},"获得性心脏病","/cardiology/acquired","3.cardiology/2.acquired",[110,114,118],{"title":111,"path":112,"stem":113,"icon":48},"DCM","/cardiology/acquired/dcm","3.cardiology/2.acquired/1.DCM",{"title":115,"path":116,"stem":117,"icon":48},"LVOTO","/cardiology/acquired/lvoto","3.cardiology/2.acquired/2.lvoto",{"title":119,"path":120,"stem":121,"icon":48},"Mavacamten","/cardiology/acquired/mavacamten","3.cardiology/2.acquired/3.Mavacamten",{"title":123,"path":124,"stem":125,"children":126,"page":6},"先天性心脏病","/cardiology/congenital","3.cardiology/3.congenital",[127,131,135],{"title":128,"path":129,"stem":130},"总览","/cardiology/congenital/congenital_heart_disease","3.cardiology/3.congenital/1.congenital_heart_disease",{"title":132,"path":133,"stem":134},"大动脉转位","/cardiology/congenital/transposition-of-the-great-arteries","3.cardiology/3.congenital/2.transposition-of-the-great-arteries",{"title":136,"path":137,"stem":138,"icon":48},"MAPCAS","/cardiology/congenital/mapcas","3.cardiology/3.congenital/3.MAPCAS",{"title":140,"path":141,"stem":142,"icon":48},"TEER","/cardiology/teer","3.cardiology/4.TEER",{"title":144,"path":145,"stem":146},"经食道超声三维解剖","/cardiology/tee","3.cardiology/5.TEE",{"title":148,"path":149,"stem":150,"children":151,"page":6},"异宠","/exotic-pet","4.exotic-pet",[152,156],{"title":153,"path":154,"stem":155,"icon":70},"松鼠","/exotic-pet/squirrel","4.exotic-pet/1.squirrel",{"title":157,"path":158,"stem":159},"兔","/exotic-pet/rabbit","4.exotic-pet/2.rabbit",{"title":161,"icon":6,"path":162,"stem":163,"children":164,"page":6},"工具","/tools","5.tools",[165,169,178,182],{"title":166,"path":167,"stem":168,"description":70},"术语","/tools/terminology","5.tools/1.terminology",{"title":170,"path":171,"stem":172,"children":173,"page":6},"影像标记","/tools/label","5.tools/2.label",[174],{"title":175,"path":176,"stem":177},"分割工具比较","/tools/label/itk-snap_3d-slicer","5.tools/2.label/1.ITK-SNAP_3D-slicer",{"title":179,"path":180,"stem":181,"icon":48},"Websites","/tools/websites","5.tools/3.websites",{"title":183,"path":184,"stem":185,"children":186,"page":6},"编写笔记","/tools/notes","5.tools/4.notes",[187,191],{"title":188,"path":189,"stem":190,"icon":70},"Markdown CheatSheet","/tools/notes/markdown","5.tools/4.notes/1.markdown",{"title":192,"path":193,"stem":194,"icon":70},"Nuxt/Vue CheatSheet","/tools/notes/nuxt","5.tools/4.notes/2.nuxt",{"id":196,"title":54,"body":197,"description":608,"extension":609,"links":48,"meta":610,"navigation":611,"path":55,"seo":612,"stem":56,"__hash__":613},"docs/2.imaging/2.thorax/3.tei.md",{"type":198,"value":199,"toc":593},"minimark",[200,211,215,223,228,243,246,261,264,273,276,286,289,300,303,312,315,323,326,330,333,339,347,353,358,361,365,371,374,382,385,389,396,404,410,418,422,425,439,443,458,464,468,475,486,492,498,509,515,541,545,548,566,570,573,580,583,589],[201,202,203,204],"p",{},"原文链接: ",[205,206,210],"a",{"href":207,"rel":208},"https://mp.weixin.qq.com/s/K4Nf0esOc8xgTMtvfLvqsg",[209],"nofollow","犬猫心脏超声中的Tei 指数（MPI）",[212,213,210],"h2",{"id":214},"犬猫心脏超声中的tei-指数mpi",[201,216,217,218,222],{},"Tei 指数，也叫 MPI（Myocardial Performance Index，心肌性能指数/心肌做功指数），是心脏超声中一个非常实用的综合功能指标。它的价值在于：",[219,220,221],"strong",{},"不像 EF那样主要反映收缩功能，也不像单一舒张参数那样只关注舒张过程，Tei 指数能够在一个数值中同时反映心脏的收缩与舒张表现","，因此在犬猫及其他小动物心脏超声评估中具有较高参考意义。从本质上讲，Tei 指数衡量的是“心脏为了完成一次有效射血，花在非射血阶段的时间，相对于真正射血时间所占的比例”。如果心脏在一次心动周期中，准备收缩和完成舒张恢复所花费的时间变长，而真正把血液射出的时间相对变短，那么这个指数就会升高。也正因为如此，Tei 指数越高，通常提示整体心肌功能越差。",[224,225,227],"h3",{"id":226},"_01-tei-指数的基本原理","01 Tei 指数的基本原理",[201,229,230,231,234,235,238,239,242],{},"理解 Tei 指数，关键在于先理解它涉及的三个时间段：\n",[219,232,233],{},"等容收缩时间（ICT，isovolumic contraction time）","\n心室开始收缩后，房室瓣已经关闭，但半月瓣尚未开放。此时心室压力正在升高，但尚未发生血液射出，因此这段时间属于“收缩准备阶段”。\n",[219,236,237],{},"射血时间（ET，ejection time）","\n当心室压力超过主动脉或肺动脉压力后，半月瓣开放，血液被真正射出。这一阶段是心脏完成有效泵血的核心时间段。\n",[219,240,241],{},"等容舒张时间（IRT，isovolumic relaxation time）","\n射血结束后，半月瓣关闭，但房室瓣尚未开放。此时心室开始舒张和压力下降，但还没有开始充盈，这段时间属于“舒张恢复阶段”。",[201,244,245],{},"Tei 指数的公式为：",[247,248,252],"pre",{"className":249,"code":250,"language":251,"meta":70,"style":70},"language-code shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","MPI = (ICT + IRT) / ET\n","code",[251,253,254],{"__ignoreMap":70},[255,256,259],"span",{"class":257,"line":258},"line",1,[255,260,250],{},[201,262,263],{},"也可以写成：",[247,265,267],{"className":249,"code":266,"language":251,"meta":70,"style":70},"MPI = (a - b) / b\n",[251,268,269],{"__ignoreMap":70},[255,270,271],{"class":257,"line":258},[255,272,266],{},[201,274,275],{},"其中：",[277,278,279,283],"ul",{},[280,281,282],"li",{},"a 表示房室瓣关闭到再次开放之间的总时间；",[280,284,285],{},"b 表示射血时间 ET。",[201,287,288],{},"由于：",[247,290,294],{"className":291,"code":292,"language":293,"meta":70,"style":70},"language-xode shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","a = ICT + ET + IRT\n","xode",[251,295,296],{"__ignoreMap":70},[255,297,298],{"class":257,"line":258},[255,299,292],{},[201,301,302],{},"所以：",[247,304,306],{"className":249,"code":305,"language":251,"meta":70,"style":70},"a - b = ICT + IRT\n",[251,307,308],{"__ignoreMap":70},[255,309,310],{"class":257,"line":258},[255,311,305],{},[201,313,314],{},"因此最终可写为：",[247,316,317],{"className":249,"code":250,"language":251,"meta":70,"style":70},[251,318,319],{"__ignoreMap":70},[255,320,321],{"class":257,"line":258},[255,322,250],{},[201,324,325],{},"用更直白的话说，Tei 指数比较的是“非有效射血时间”与“有效射血时间”的比例。分子越大、分母越小，说明心脏整体效率越差。",[224,327,329],{"id":328},"_02-tei-指数反映的功能意义","02 Tei 指数反映的功能意义",[201,331,332],{},"Tei 指数之所以重要，是因为它并不是单纯反映心脏某一个方面的功能，而是同时受到收缩功能和舒张功能的影响。",[201,334,335,338],{},[219,336,337],{},"对收缩功能的反映","\n当心室收缩能力下降时，常可见：",[277,340,341,344],{},[280,342,343],{},"等容收缩时间延长",[280,345,346],{},"射血时间缩短\n这样就会导致 MPI 升高。",[201,348,349,352],{},[219,350,351],{},"对舒张功能的反映","\n当心室舒张功能变差、舒张减慢时，常可见：",[277,354,355],{},[280,356,357],{},"等容舒张时间延长\n这同样会使 MPI 升高。",[201,359,360],{},"因此，Tei 指数可以理解为一个“整体心功能效率指标”。它不能完全替代其他参数，但可以作为一个综合性较强的辅助指标，用于评估病患心肌整体表现。",[224,362,364],{"id":363},"_03-如何理解-tei-指数的高低","03 如何理解 Tei 指数的高低",[201,366,367,368],{},"临床解释 Tei 指数时，最核心的原则是：\n",[219,369,370],{},"Tei 指数越高，通常表示整体心肌功能越差。",[201,372,373],{},"原因在于：",[277,375,376,379],{},[280,377,378],{},"心脏花在等容收缩和等容舒张上的时间变长",[280,380,381],{},"真正完成射血的时间变短\n这意味着心脏“准备和恢复”的过程占比增大，而“真正工作”的效率下降。",[201,383,384],{},"可以用一个简单类比帮助理解：把心脏想象成一个水泵。若这个水泵每次工作时，预压准备很久，卸压恢复也很久，而真正抽水的时间反而缩短，那么它整体效率就会下降。Tei 指数正是从这个角度来衡量心脏工作状态。",[224,386,388],{"id":387},"tei-指数在超声中的测量方法","Tei 指数在超声中的测量方法",[201,390,391,392,395],{},"在心脏超声检查中，Tei 指数通常可以通过两类方法测得：\n",[219,393,394],{},"脉冲多普勒法（PW Doppler）","\n通过血流频谱测量：",[277,397,398,401],{},[280,399,400],{},"房室瓣流入相关时间参数",[280,402,403],{},"主动脉或肺动脉射血时间\n然后带入公式进行计算。",[201,405,406,409],{},[219,407,408],{},"组织多普勒法（TDI）","\n通过瓣环或局部心肌组织运动频谱来测定各时间间隔，常见测量部位包括：",[277,411,412,415],{},[280,413,414],{},"二尖瓣环",[280,416,417],{},"三尖瓣环\nTDI 法的优势在于，某些情况下可以在同一个心动周期中更方便地获得多个时间参数，因此在小动物心超评估中较为常用。尤其在评估局部心肌运动和整体时间关系时，TDI 与 MPI 的结合很有实践意义。",[224,419,421],{"id":420},"_05-tei-指数与-ef-的区别","05 Tei 指数与 EF 的区别",[201,423,424],{},"在兽医临床中，很多医生首先熟悉的是 EF（射血分数）。EF 当然很重要，但它与 Tei 指数关注的重点并不完全相同。\nEF 主要反映：",[277,426,427,430,433,436],{},[280,428,429],{},"左心室收缩功能",[280,431,432],{},"一次收缩中泵出血液的比例\n而 Tei 指数更关注：",[280,434,435],{},"收缩与舒张的综合表现",[280,437,438],{},"心脏完成一次有效泵血的整体时间效率\n因此，EF 正常并不代表 Tei 指数一定正常。某些早期功能异常，尤其是舒张异常或整体效率下降的情况，可能在 EF 尚未明显异常时，就已经表现为 MPI 升高。\n换句话说，EF 更像是在看“泵得多不多”，而 MPI 更像是在看“这次泵血过程的整体效率好不好”。",[224,440,442],{"id":441},"_06-tei-指数在兽医临床中的应用价值","06 Tei 指数在兽医临床中的应用价值",[201,444,445,446,449,450,453,454,457],{},"在兽医心脏超声中，Tei 指数常可用于以下场景：\n",[219,447,448],{},"评估左心室整体功能","\n对于存在心肌病、慢性容量负荷异常或疑似早期心功能损害的病患，MPI 可作为综合参考指标。\n",[219,451,452],{},"评估右心室功能","\nTei 指数在右心功能评估中尤其有价值。对于疑似肺动脉高压、右心负荷增加或右心功能异常的病患，右心 MPI 常可提供补充信息。\n",[219,455,456],{},"监测病程和治疗反应","\n在一些慢性心脏疾病病患中，MPI 可用于随访整体心肌功能变化，辅助观察病情进展及治疗后的功能改善情况。",[201,459,460,463],{},[219,461,462],{},"作为 TDI 评估体系中的一部分","\n如果临床上已进行组织多普勒检查，那么将其与 MPI 结合，可进一步提高对心肌整体功能状态的判断深度。",[224,465,467],{"id":466},"_07-tei-指数的局限性","07 Tei 指数的局限性",[201,469,470,471,474],{},"虽然 Tei 指数有重要价值，但它并不是万能指标，解读时应注意以下局限：\n",[219,472,473],{},"受心率和节律影响","\n如果病患存在：",[277,476,477,480,483],{},[280,478,479],{},"心律不齐",[280,481,482],{},"心动过速",[280,484,485],{},"明显传导异常\n则时间间隔测量可能不稳定，从而影响 MPI 的准确性。",[201,487,488,491],{},[219,489,490],{},"受瓣膜病影响","\n明显瓣膜病变可能改变流入、流出及等容期时间，因此在解读时必须结合瓣膜结构与血流信息综合判断。",[201,493,494,497],{},[219,495,496],{},"受前负荷和后负荷变化影响","\n例如：",[277,499,500,503,506],{},[280,501,502],{},"血容量变化",[280,504,505],{},"血压变化",[280,507,508],{},"肺动脉压力变化\n都可能使 MPI 发生波动，因此它不是绝对独立于负荷条件的指标。",[201,510,511,514],{},[219,512,513],{},"不能脱离整体超声结果单独解释","\nTei 指数只能作为整体超声评估的一部分，不能单独作为诊断结论。临床上仍需结合以下 进行综合判断：",[277,516,517,520,523,526,529,532,535,538],{},[280,518,519],{},"EF 或 FS",[280,521,522],{},"E/A",[280,524,525],{},"E/e'",[280,527,528],{},"TDI 各项参数",[280,530,531],{},"心腔大小",[280,533,534],{},"壁运动情况",[280,536,537],{},"瓣膜结构与反流情况",[280,539,540],{},"临床症状与体征",[224,542,544],{"id":543},"_08-临床理解要点","08 临床理解要点",[201,546,547],{},"对于兽医师而言，掌握 Tei 指数时可以抓住以下几个核心点：",[549,550,551,554,557,560,563],"ol",{},[280,552,553],{},"Tei 指数是综合指标，不仅看收缩，也看舒张。",[280,555,556],{},"Tei 指数越高，通常提示整体心功能越差。",[280,558,559],{},"公式本质是“非射血时间 / 射血时间”。",[280,561,562],{},"它适合作为整体功能参考，而不是替代所有其他心超参数。",[280,564,565],{},"在右心功能评估及 TDI 相关分析中，Tei 指数尤其值得关注。",[224,567,569],{"id":568},"_09-总结","09 总结",[201,571,572],{},"Tei 指数（MPI）是心脏超声中一个重要的综合功能指标，其核心思想是：比较心脏在一个心动周期内“非射血时间”与“有效射血时间”的比例。它能够同时反映收缩与舒张功能，因此比单纯的收缩指标更全面。\n其公式为：",[247,574,578],{"className":575,"code":250,"language":577,"meta":70},[576],"language-text","text",[251,579,250],{"__ignoreMap":70},[201,581,582],{},"当等容收缩时间延长、等容舒张时间延长，或射血时间缩短时，MPI 会升高。一般而言，MPI 越高，提示整体心肌性能越差。\n在兽医临床中，Tei 指数适用于左、右心整体功能评估，也可用于病程监测与 TDI 联合分析。但在实际应用中，应始终结合其他超声参数及病患整体临床情况综合解读，避免孤立使用。\n一句话概括：",[247,584,587],{"className":585,"code":586,"language":577,"meta":70},[576],"Tei 指数衡量的是“心脏为了完成一次有效泵血，花了多少无效准备与恢复时间，相对于真正射血时间的比例”；比例越大，通常说明整体心功能越差。\n",[251,588,586],{"__ignoreMap":70},[590,591,592],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":70,"searchDepth":594,"depth":594,"links":595},2,[596],{"id":214,"depth":594,"text":210,"children":597},[598,600,601,602,603,604,605,606,607],{"id":226,"depth":599,"text":227},3,{"id":328,"depth":599,"text":329},{"id":363,"depth":599,"text":364},{"id":387,"depth":599,"text":388},{"id":420,"depth":599,"text":421},{"id":441,"depth":599,"text":442},{"id":466,"depth":599,"text":467},{"id":543,"depth":599,"text":544},{"id":568,"depth":599,"text":569},"原文链接: 犬猫心脏超声中的Tei 指数（MPI）","md",{},true,{"title":54,"description":608},"svTP_yEzi9KCMp8_0UU5dbfOr16P8jSBjJXCY6UHOGc",[615,616],{"title":50,"path":51,"stem":52,"description":70,"icon":48,"children":-1},{"title":63,"path":64,"stem":65,"description":70,"children":-1},1794491726450]